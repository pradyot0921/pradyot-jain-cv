/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/profile/*
  Cache-Control: public, max-age=86400

/assets/logos/*
  Cache-Control: public, max-age=86400

/assets/projects/*
  Cache-Control: public, max-age=86400

/assets/certificates/*
  X-Robots-Tag: noindex

/assets/resumes/*
  X-Robots-Tag: noindex
